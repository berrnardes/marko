{
	"name": "marko",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "next dev -p 3001",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"worker": "tsx --env-file=.env src/worker/index.ts",
		"worker:dev": "tsx watch --env-file=.env src/worker/index.ts",
		"worker:start": "tsx src/worker/index.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:clear": "tsx --env-file=.env scripts/clear-db.ts",
		"db:seed-admin": "tsx --env-file=.env scripts/seed-admin.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@tanstack/react-query": "^5.101.0",
		"better-auth": "^1.6.14",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"csv-parse": "6.2.1",
		"drizzle-orm": "^0.45.2",
		"input-otp": "^1.4.2",
		"lucide-react": "^1.24.0",
		"next": "^16.2.7",
		"next-themes": "^0.4.6",
		"pg": "^8.21.0",
		"pg-boss": "^12.18.2",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"shadcn": "^4.13.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tsx": "^4.22.4",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@tanstack/eslint-plugin-query": "^5.101.0",
		"@types/node": "^20",
		"@types/pg": "^8.20.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9",
		"eslint-config-next": "16.2.7",
		"fast-check": "^4.8.0",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^4.1.8"
	},
	"overrides": {
		"postcss": "^8.5.10",
		"kysely": "~0.28.17"
	},
	"allowScripts": {
		"sharp@0.34.5": true,
		"unrs-resolver@1.12.2": true,
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.0": true
	}
