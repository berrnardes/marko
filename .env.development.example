# Variáveis de DESENVOLVIMENTO local (app Next.js + worker + docker-compose.dev.yml).
#
# Copie para `.env` — é esse o arquivo que os três consumidores leem:
#   - `npm run dev`        → o Next.js carrega `.env` automaticamente
#   - `npm run worker:dev` → `tsx --env-file=.env`
#   - `npm run db:migrate` → drizzle.config.ts via `dotenv/config`
#   - docker compose       → interpola `${...}` a partir do `.env` do diretório
#
#   cp .env.development.example .env
#
# Nenhuma destas variáveis é obrigatória para o stack SUBIR (o
# docker-compose.dev.yml tem default para todas), mas o app precisa delas — em
# especial DATABASE_URL, BETTER_AUTH_SECRET e WAHA_WEBHOOK_HMAC_SECRET.
#
# O contraponto de produção é `.env.production.example` (worker + WAHA no
# Hetzner). Não misture os dois: aqui tudo é local e descartável.

# --- Banco de dados (container `postgres` do docker-compose.dev.yml) ---------
# Estes três alimentam o container. O DATABASE_URL abaixo tem que casar com
# eles — é o mesmo banco, visto do host.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marko
# Descomente se a 5432 do host já estiver ocupada por um Postgres nativo
# (ajuste também a porta no DATABASE_URL).
# POSTGRES_PORT=5433

# Como o app, o worker e o drizzle-kit (todos no host) chegam ao banco.
# Sem `sslmode`: em dev não há TLS nem PgBouncer no caminho.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/marko"

# --- Autenticação (Better Auth) ---------------------------------------------
# Segredo de assinatura das sessões. Em dev qualquer string longa serve; gere uma
# com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-local-qualquer
# URL de origem do app em dev (o `npm run dev` sobe na 3001, não na 3000).
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001

# Primeiro usuário, criado por `npm run db:seed-admin`.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Admin
# ADMIN_RESET_PASSWORD=yes   # redefine a senha de um admin que já existe

# --- WAHA (container `waha` do docker-compose.dev.yml) ----------------------
# A MESMA chave é injetada no container e usada pelo app/worker como X-Api-Key.
WAHA_API_KEY=dev-waha-key
# Engine do WhatsApp usado nas sessões NOVAS. GOWS é browserless: o QR aparece em
# segundos na tela "Conectar novo número". O default do WAHA (WEBJS) sobe um
# Chromium por sessão e demora minutos para sair de STARTING.
WAHA_ENGINE=GOWS
# O app (host) fala com o WAHA pela porta publicada. O worker rodando no profile
# `worker` do compose usa `http://waha:3000`, injetado pelo próprio compose.
WAHA_BASE_URL=http://localhost:3000
# Segredo do HMAC do webhook inbound. Precisa ser idêntico dos dois lados: o
# compose injeta este valor no WAHA (WHATSAPP_HOOK_HMAC_KEY) e a rota
# /api/waha/webhook o exige para validar a assinatura.
WAHA_WEBHOOK_HMAC_SECRET=dev-hmac-secret
# Para onde o WAHA entrega os eventos. `host.docker.internal` é o host visto de
# dentro do container (o compose mapeia esse nome via `host-gateway`).
WAHA_WEBHOOK_URL=http://host.docker.internal:3001/api/waha/webhook
# Basic Auth do dashboard (http://localhost:3000/dashboard) e do swagger.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=admin

# --- Repasse ao consultor (handoff) -----------------------------------------
# Números (E.164) que recebem o alerta de lead quente. Vazio => alerta desligado
# (o normal em dev, para não disparar WhatsApp de verdade sem querer).
CONSULTANT_NOTIFY_NUMBERS=
# CONSULTANT_NOTIFY_FROM_NUMBER=default
CRM_BASE_URL=http://localhost:3001

# --- Observabilidade / atalhos de teste -------------------------------------
# Fora de produção o logger já usa `debug` + pino-pretty; suba para `info` se o
# volume incomodar.
LOG_LEVEL=debug
# Cadência em SEGUNDOS com 3 toques em vez de 5 toques / 15 dias. Ligue (=1)
# apenas para testar o fluxo ponta a ponta; nunca em produção.
CADENCE_TEST_MODE=0
# Trava de segurança do `npm run db:clear` (só apaga com CLEAR_DB_CONFIRM=yes).
# CLEAR_DB_CONFIRM=yes
